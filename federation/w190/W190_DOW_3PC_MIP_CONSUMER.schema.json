{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w190-dow-3pc-mip-consumer/1.0",
  "type": "object",
  "required": ["schema_version", "wave", "repo", "consumed_child_head_sha", "dow_disposition"],
  "properties": {
    "schema_version": {"const": "w190-dow-3pc-mip-consumer/1.0"},
    "wave": {"const": "W190"},
    "repo": {"const": "GBOGEB/ABACUS"},
    "consumed_child_head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "dow_disposition": {"enum": ["ACCEPT_HANDOVER_DEFER_GLOBAL_DOV", "REJECT", "DEFER"]}
  }
}
