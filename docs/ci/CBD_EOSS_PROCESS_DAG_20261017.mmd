        E4 --> E5[N and N+1 matched parity]
    end
    subgraph FED[FEDERATION - CODEX, ABACUS, QPS E6]
        E6{Security + governance + A10 + reviewer?}
        D[Derived dashboards / BD ledger]
        H[Main admission HOLD]
    end
    E2 --> E3
    E5 --> E6
    J -. candidate only .-> D
    C -. matched scope .-> D
    E6 -->|incomplete| H
