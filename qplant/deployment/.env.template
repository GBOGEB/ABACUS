# ─────────────────────────────────────────────────────────────────────────────
# QPLANT Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.template .env
# ─────────────────────────────────────────────────────────────────────────────

# Environment: dev | staging | prod | dr
QPLANT_ENV=dev

# Config path (relative to project root inside container)
QPLANT_CONFIG_PATH=/app/handover_dashboard/data/config.yaml

# API Settings
API_HOST=0.0.0.0
API_PORT=8100
API_WORKERS=1
LOG_LEVEL=DEBUG

# Config Service Settings
CONFIG_SERVICE_PORT=8200
CONFIG_AUTO_RELOAD=true
CONFIG_RELOAD_INTERVAL=10

# Monitoring
MONITORING_PORT=8300

# Security (Production only)
# CORS_ORIGINS=https://your-domain.com
# API_KEY=your-secret-key
# SSL_CERT_PATH=/etc/ssl/certs/qplant.crt
# SSL_KEY_PATH=/etc/ssl/private/qplant.key
