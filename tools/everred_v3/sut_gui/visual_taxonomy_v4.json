{
  "schema": "code-purple.visual-taxonomy.v4",
  "description": "Visual semantics are disjoint axes; color conveys outcome only when paired with a text label.",
  "axes": {
    "node_function": {
      "channel": "shape",
      "mapping": {
        "activity": "neutral_rectangle",
        "decision": "purple_outline_diamond"
      }
    },
    "phase": {
      "channel": "explicit_P_number",
      "mapping": {
        "prefix": "P1-P8",
        "meaning": "ordered process phase"
      }
    },
    "owner": {
      "channel": "role_text",
      "mapping": {
        "key": "Role:",
        "root_rule": "one accountable repair owner per confirmed causal root"
      }
    },
    "execution_outcome": {
      "channel": "unique_color_plus_label",
      "mapping": {
        "success": {
          "color": "#77e2b0",
          "label": "SUCCESS",
          "scope": "completed native execution"
        },
        "failure": {
          "color": "#ff9f9f",
          "label": "FAILURE",
          "scope": "completed native execution"
        },
        "cancelled": {
          "color": "#ffad77",
          "label": "CANCELLED",
          "scope": "terminated before normal completion"
        },
        "in_progress": {
          "color": "#84d9ff",
          "label": "IN PROGRESS",
          "scope": "nonterminal"
        },
        "queued": {
          "color": "#aebdcf",
          "label": "QUEUED",
          "scope": "pending/waiting"
        },
        "skipped": {
          "color": "#b4a6d6",
          "label": "SKIPPED",
          "scope": "not executed"
        }
      }
    },
    "path_disposition": {
      "channel": "branch_label_plus_conditional_outcome",
      "mapping": {
        "yes": "green | YES | eligible path only",
        "no": "red | NO | HOLD"
      }
    },
    "edge_flow": {
      "channel": "line_style_plus_label",
      "mapping": {
        "forward": "solid | DAG dependency",
        "feedback": "dashed amber | next-pulse recurrence/RCA",
        "feedforward": "double cyan | planned SUT preflight"
      }
    }
  },
  "constraints": [
    "No operational meaning assigned to a filled purple brand card.",
    "Colors cannot replace named role, numbered phase or proof level.",
    "No identical HEX color for two native execution outcomes.",
    "Conditional green YES does not signify actual present admission.",
    "Forward DAG is acyclic; feedback/feedforward visualized in independent overlay.",
    "The rendered UI must retain text state labels for accessibility and disambiguation.",
    "Repository test/coverage proof and physical plant safety colors are separate domains."
  ],
  "authority_transfer": false
}
