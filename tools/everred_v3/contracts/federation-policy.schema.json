{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abacus.everred.federation-policy.v1",
  "title": "Cross-repository observational federation rules",
  "type": "object",
  "required": ["schema", "version", "mesh_reference", "consumer_authority", "bindings"],
  "properties": {
    "schema": {"const": "abacus.everred.federation-policy.v1"},
    "version": {"type": "string", "minLength": 1},
    "mesh_reference": {"const": ".mesh/MESH_DOCK.yaml"},
    "consumer_authority": {"const": "independent"},
    "bindings": {
      "type": "array", "minItems": 1,
      "items": {"type": "object",
        "required": ["producer", "consumer", "domain", "action"],
        "properties": {
          "producer": {"type": "string", "minLength": 3},
          "consumer": {"type": "string", "minLength": 3},
          "domain": {"type": "string", "minLength": 1},
          "action": {"const": "OBSERVATION_ONLY"}
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
