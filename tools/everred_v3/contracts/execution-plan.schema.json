{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abacus.everred.execution-plan.v1",
  "title": "EVERRED immutable DAG and worker write surface",
  "type": "object",
  "required": ["schema", "version", "canonical_workflow_policy", "tasks"],
  "properties": {
    "schema": {"const": "abacus.everred.execution-plan.v1"},
    "version": {"type": "string", "minLength": 1},
    "canonical_workflow_policy": {"const": "ci/governance/workflow_policy.json"},
    "authority": {"const": "observational_only"},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "plane", "owner", "mode", "needs", "write_paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "plane": {"enum": ["diagnostic", "runtime", "orchestration", "evidence"]},
          "owner": {"type": "string", "minLength": 1},
          "mode": {"enum": ["READ_ONLY", "NATIVE_PROBE", "REVIEW_REQUIRED"]},
          "needs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "write_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
