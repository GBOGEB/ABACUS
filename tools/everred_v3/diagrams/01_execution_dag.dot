digraph everred {
 graph [rankdir=LR,bgcolor="#0d1020",pad="0.48",nodesep="0.48",ranksep="0.83",splines=polyline,outputorder=edgesfirst,fontname="DejaVu Sans",labelloc=t,label=<<FONT POINT-SIZE="25" COLOR="#f5f1ff"><B>EVERRED / V3     CONTROLLED RECOVERY DAG</B></FONT><BR/><FONT POINT-SIZE="12" COLOR="#a6a0bc">Observe → causal attribution → canonical repair → consumer replay → governed admission</FONT>>,fontcolor="#f0eaff"];
