 edge [color="#807ca7",arrowsize=0.65,penwidth=1.3];
 subgraph cluster_0 {label="01    OBSERVE / DEFINE";color="#454562";fontcolor="#c6b8ff";style="rounded,dashed"; G[label="CI / RHEL / Docker / LDAB\nExact source and run"]; L[label="Append-only ledger\nReceipt hash chain",fillcolor="#30264f",color="#936cff"]; F[label="Versioned signature\nnot causal proof"]; G->L->F;}
 subgraph cluster_1 {label="02    ANALYZE / OWN";color="#454562";fontcolor="#c6b8ff";style="rounded,dashed"; X[label="Existing confirmed root?",shape=diamond,fillcolor="#3a2c48"]; E[label="Attach occurrence\nto canonical root"]; R[label="Counterfactual RCA\nmain · PR · runner"]; Q[label="Verified cause?",shape=diamond,fillcolor="#3a2c48"]; U[label="UNKNOWN\nPreserve hypothesis",color="#ea789a",fillcolor="#431f34"]; C[label="Persistent root ID"]; O[label="One owner + path lease\n+ idempotency",fillcolor="#31294d",color="#a78bfa"]; X->E[label="yes",color="#77c9ba"]; X->R[label="no"]; R->Q; Q->U[label="no",color="#ea789a"]; Q->C[label="yes",color="#77c9ba"]; E->O;C->O;}
 subgraph cluster_2 {label="03    IMPROVE / VERIFY";color="#454562";fontcolor="#c6b8ff";style="rounded,dashed"; P[label="Canonical repair\nsource ownership",fillcolor="#30264f",color="#a78bfa"]; V[label="Focused / negative tests\nP0–P2 receipts"]; T[label="Exact-head PASS?",shape=diamond,fillcolor="#3a2c48"]; A[label="RED · new attempt\nsame root",fillcolor="#431f34",color="#ea789a"]; W[label="P3 isolated\nconsumer fan-out"]; N[label="P4 native\nexact-head CI"]; P->V->T;T->A[label="no",color="#ea789a"];T->W[label="yes",color="#77c9ba"];W->N;}
 subgraph cluster_3 {label="04    CONTROL / ADMIT";color="#454562";fontcolor="#c6b8ff";style="rounded,dashed"; K[label="Scope-matched\nmetrics + fingerprints"]; I[label="Independent security\nreview + protection"]; Z[label="All gates PASS?",shape=diamond,fillcolor="#3a2c48"]; H[label="HOLD · no merge\nWIP continues",fillcolor="#431f34",color="#ea789a"]; M[label="Authorized merge",fillcolor="#163b3e",color="#42d3c0"]; J[label="P6 exact-main proof",fillcolor="#163b3e",color="#42d3c0"]; S[label="P7 recurrence\nsentinel + closure",fillcolor="#163b3e",color="#42d3c0"];K->I->Z;Z->H[label="no",color="#ea789a"];Z->M[label="yes",color="#77c9ba"];M->J->S;}
 F->X; O->P;N->K;
 D[label="Unrelated WIP\ncontinues",fillcolor="#252e45",color="#6998e7"];L->D[style=dashed,color="#6998e7",constraint=false];
