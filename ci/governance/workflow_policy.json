  "clusters": {
    "core_test": {"canonical": "ci-abacus.yml", "intent": "Fast cross-version unit, pre-commit and smoke evidence."},
    "full_regression": {"canonical": "ci-cd-tests.yml", "intent": "Broad OS/version/integration/coverage regression for code changes."},
    "statistics": {"canonical": "ci-cd.yml", "intent": "Bootstrap, AHT, performance and statistical validation."},
    "bridge_federation": {"canonical": "bridge-ci.yml", "intent": "CODEX/ABACUS bridge contract and federation smoke evidence."},
    "dmaic": {"canonical": "dmaic-enterprise-ci.yml", "intent": "DMAIC phase, convergence and maturity execution."},
    "dow": {"canonical": "dow-integration.yml", "intent": "DOW parent mechanics, integration, monitoring and warm-up."},
    "runtime_governance": {"canonical": "governance.yml", "intent": "Runtime evidence, governance, review artifacts and schema validation."},
    "security": {"canonical": "security-scan.yml", "intent": "Ruff security, Bandit, CodeQL, dependency and supply-chain scanning."},
    "delivery": {"canonical": "cd-pipeline.yml", "intent": "Build, release, deployment and publication."},
    "documentation": {"canonical": "docs-build.yml", "intent": "Documentation validation, rendering, export and Pages."},
    "automation": {"canonical": "post-merge-pr-summary.yml", "intent": "Repository maintenance, reporting, branch and PR automation."},
    "specialised": {"canonical": "qps-cost-roundtrip-contract.yml", "intent": "Bounded product or historical pipelines retained outside core CI."},
    "ci_governance": {"canonical": "ci-governance.yml", "intent": "This policy, inventory, overlap and staleness gate."},
