  },
  "branch_push_controls": {
    "intent": "Avoid duplicate feature-branch push fan-out; retain these push workflows on main while PR or manual coverage remains separate.",
    "main_only": [
      "review-artifact-validation.yml",
      "validation.yml",
      "export-docs.yml",
      "runtime-smoke.yml",
      "governance.yml",
      "yaml-validation.yml",
      "recursive-build.yml",
      "docs-build.yml",
      "deploy-docs.yml"
    ]
